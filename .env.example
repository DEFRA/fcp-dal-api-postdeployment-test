# Copy to .env and fill in. Loaded by `npm run test:local`; shell variables take precedence.

# Target environment: dev | test | ext-test | perf-test
ENVIRONMENT=dev

# GraphQL endpoint. When unset, the in-platform host is used:
# https://fcp-dal-api.<ENVIRONMENT>.cdp-int.defra.cloud/graphql
API_URL=https://fcp-dal-api.api.dev.cdp-int.defra.cloud/graphql

# Bearer token, not needed for dev. Can also be passed as `npm run test:local -- AUTH_TOKEN=...`
# AUTH_TOKEN=
